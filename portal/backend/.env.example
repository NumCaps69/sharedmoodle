PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://smadmin:changeme@localhost:5432/sharedmoodle
# Alternative avec secret Docker : POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# JWT
JWT_SECRET=changeme-super-secret-key-min-32-chars
# Alternative avec secret Docker : JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Domaine
DOMAIN=sharedmoodle.fr
FRONTEND_ORIGINS=http://localhost:5500,http://localhost:8080

# Docker (pour le provisioning)
DOCKER_SOCKET=/var/run/docker.sock
PROVISIONING_MODE=simulate
STACK_TEMPLATE_PATH=../../infra/templates/client-stack.yml.template
STACK_OUTPUT_DIR=../../infra/stacks
NFS_SERVER=10.0.0.10
NFS_BASE_PATH=/srv/nfs/sharedmoodle
